# Application
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://pfin:pfin@localhost:5432/pfin?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
